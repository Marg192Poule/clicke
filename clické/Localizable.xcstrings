    "Clické %@ at %@" : {
      "comment" : "Default file name of a capture: date, then time",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clické %1$@ at %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické %1$@ à %2$@"
          }
        }
      }
    },
    "Clické can capture the contents of your screen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické peut capturer le contenu de votre écran."
          }
        }
      }
    },
    "Clické couldn’t save to “%@”. The folder may have been moved, or Clické may not have permission to write to it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické n’a pas pu enregistrer dans « %@ ». Le dossier a peut-être été déplacé, ou Clické n’a peut-être pas l’autorisation d’y écrire."
          }
        }
      }
    },
    "Clické Editor" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éditeur Clické"
          }
        }
      }
    },
    "Clické needs Screen Recording permission to take screenshots. Turn on Clické in System Settings > Privacy & Security > Screen & System Audio Recording. macOS may ask you to quit and reopen Clické." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické a besoin de l’autorisation d’enregistrement de l’écran pour prendre des captures d’écran. Activez Clické dans Réglages Système > Confidentialité et sécurité > Enregistrement de l’écran et des sons du système. macOS peut vous demander de quitter puis de rouvrir Clické."
          }
        }
      }
    },
    "Clické needs this permission to capture your screen. After allowing it, macOS may ask you to reopen Clické." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické a besoin de cette autorisation pour capturer votre écran. Une fois l’accès autorisé, macOS peut vous demander de rouvrir Clické."
          }
        }
      }
    },
    "Clické needs your approval in System Settings to open at login." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clické a besoin de votre approbation dans Réglages Système pour se lancer à l’ouverture de session."
