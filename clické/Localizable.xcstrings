{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” can’t be found. Choose another folder." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est introuvable. Choisissez un autre dossier."
          }
        }
      }
    },
    "“%@” couldn’t be added." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être ajouté."
          }
        }
      }
    },
    "“%@” has too many pixels to be edited." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » contient trop de pixels pour être modifié."
