        }
      }
    },
    "%@ can’t be used. Include ⌘, ⌥ or ⌃, or use a function key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’utiliser %@. Incluez ⌘, ⌥ ou ⌃, ou utilisez une touche de fonction."
